[18.236213538,"o","\u001b[1;15H\u001b[3m\u001b[38;2;140;140;140;48;2;1;38;36mli \u001b[1;143H\u001b[23m\u001b[38;2;0;169;160;48;2;1;38;36m⣷\u001b[3;47H\u001b[38;2;188;199;198;48;2;1;38;36m Overview \u001b[3;58H\u001b[1m\u001b[38;5;0;48;2;0;169;160m Backlog \u001b[4;35H\u001b[22m\u001b[38;2;188;199;198;48;2;1;38;36mBacklog\u001b[4;44H\u001b[1m\u001b[38;2;0;169;160;48;2;1;38;36mL1 — ghscaff: self-update replaces the running binary instead of\u001b[5;35Hpiping the installer\u001b[22m\u001b[39;48;2;1;38;36m  \u001b[6;35H                                               \u001b[7;35H\u001b[38;5;15;48;2;1;38;36m# TARGET REPOSITORY\u001b[8;35H\u001b[39;48;2;1;38;36m                            \u001b[9;35H\u001b[38;5;15;48;2;1;38;36m**`ghscaff`**, at `/home/jheisonmbliv\u001b[9;73Hc\u001b[9;75Hm/Project\u001b[9;85H/UniverLab/ghscaff`, on\u001b[10;35Hbranch `feature/sponsor-and-checks`.\u001b[11;35H\u001b[39;48;2;1;38;36m           \u001b[12;35H\u001b[38;5;15;48;2;1;38;36mThis loop's workdir is the UniverLab workspace, not one repo. Every file you\u001b[13;35Htouch and every git command you run belongs to `ghscaff` and nothing else.\u001b[14;35HLeave `gitkit`, `texforge` and every other directory untouched — another\u001b[15;35Hloop is writing to `texforge` right now.\u001b[39;48;2;1;38;36m      \u001b[15;82H  \u001b[15;85H         \u001b[17;35H\u001b[38;5;15;48;2;1;38;36m# OBJECTIVE / EXPECTED OUTCOME\u001b[18;35H\u001b[39;48;2;1;38;36m             \u001b[18;49H \u001b[18;52H     \u001b[18;58H      \u001b[19;35H\u001b[38;5;15;48;2;1;38;36mghscaff's updater shells out to the public install script, which always\u001b[20;35Hwrites to `~/.local/bin`. If the user installed ghscaff any other way, that\u001b[21;35Hproduces a SECOND binary and the update silently does nothing.\u001b[39;48;2;1;38;36m    \u001b[21;102H      \u001b[22;37H \u001b[22;39H         \u001b[22;49H \u001b[22;51H         \u001b[22;61H         \u001b[22;71H       \u001b[22;79H     \u001b[22;85H \u001b[22;87H        \u001b[22;96H      \u001b[23;35H\u001b[38;5;15;48;2;1;38;36mExpected outcome: updating replaces the binary that is running, wherever it\u001b[24;35Hlives — and when that binary came from `cargo install`, ghscaff says so and\u001b[25;35Hhands back the right command instead of writing a copy somewhere else.\u001b[26;37H\u001b[39;48;2;1;38;36m \u001b[26;39H      \u001b[26;46H            \u001b[26;59H \u001b[26;61H  \u001b[26;64H        \u001b[26;73H  \u001b[26;76H           \u001b[26;88H        \u001b[26;97H        \u001b[26;106H  \u001b[27;35H\u001b[38;5;15;48;2;1;38;36m# CURRENT CODE\u001b[39;48;2;1;38;36m  \u001b[27;52H     \u001b[28;35H                                                                         \u001b[29;35H\u001b[38;5;15;48;2;1;38;36m`src/main.rs`, `run_installer()`:\u001b[30;37H\u001b[39;48;2;1;38;36m \u001b[30;39H     \u001b[30;45H           \u001b[30;57H        \u001b[30;66H   \u001b[30;70H        \u001b[30;79H    \u001b[30;84H       \u001b[30;92H     \u001b[30;98H       \u001b[31;35H\u001b[38;5;15;48;2;1;38;36m```rust\u001b[39;48;2;1;38;36m                                                                    \u001b[32;35H\u001b[38;5;15;48;2;1;38;36mmatch std::process::Command::new(\"sh\")\u001b[33;35H    .args([\u001b[33;47H\u001b[39;48;2;1;38;36m         \u001b[33;57H           \u001b[33;69H       \u001b[33;77H  \u001b[33;80H    \u001b[33;85H       \u001b[33;93H   \u001b[33;97H   \u001b[34;35H\u001b[38;5;15;48;2;1;38;36m        \"-c\",\u001b[34;49H\u001b[39;48;2;1;38;36m          \u001b[34;60H     \u001b[35;35H\u001b[38;5;15;48;2;1;38;36m        \"curl -fsSL\u001b[39;48;2;1;38;36m                                              \u001b[36;35H\u001b[38;5;15;48;"]
